{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-lambda-determinism-verifier.local/contracts/engine-verdict-schema.json",
  "$comment": "Única línea que engine/ escribe en stdout (contrato CLI en contracts/README.md). Reutiliza Result y Error del registro para que el orquestador copie los campos sin transformarlos. No incluye tiempos: la salida del engine es determinística byte a byte. 'runtime_error' es un error del programa ya verificado (DIVISION_BY_ZERO, NUMERIC_OVERFLOW), no del engine.",
  "title": "Veredicto del engine",
  "type": "object",
  "properties": {
    "outcome": { "enum": ["executed", "blocked", "runtime_error"] },
    "stage": { "enum": ["parse", "scope", "typecheck", "execution"] },
    "result": { "anyOf": [{ "$ref": "output-record-schema.json#/$defs/Result" }, { "type": "null" }] },
    "error": { "anyOf": [{ "$ref": "output-record-schema.json#/$defs/Error" }, { "type": "null" }] }
  },
  "required": ["outcome", "stage", "result", "error"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "executed" } } },
      "then": {
        "properties": {
          "stage": { "const": "execution" },
          "result": { "$ref": "output-record-schema.json#/$defs/Result" },
          "error": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "blocked" } } },
      "then": {
        "properties": {
          "stage": { "enum": ["parse", "scope", "typecheck"] },
          "result": { "type": "null" },
          "error": { "$ref": "output-record-schema.json#/$defs/Error" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "runtime_error" } } },
      "then": {
        "properties": {
          "stage": { "const": "execution" },
          "result": { "type": "null" },
          "error": {
            "allOf": [
              { "$ref": "output-record-schema.json#/$defs/Error" },
              { "properties": { "code": { "enum": ["DIVISION_BY_ZERO", "NUMERIC_OVERFLOW"] } } }
            ]
          }
        }
      }
    }
  ]
}
