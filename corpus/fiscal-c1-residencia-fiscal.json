  "canonical_python": "from decimal import Decimal\n\ndef evaluate_rule(data):\n    exento = (data['es_estudiante'] and data['anios_exento_estudiante'] < 5) or (\n        data['es_docente_o_aprendiz'] and data['anios_exento_ultimos_6'] < 2\n    )\n    if exento:\n        return 'No residente'\n    dias = Decimal(data['dias_2025']) + Decimal(data['dias_2024']) / 3 + Decimal(data['dias_2023']) / 6\n    if data['dias_2025'] >= 31 and dias >= 183:\n        return 'Residente'\n    return 'No residente'\n",
