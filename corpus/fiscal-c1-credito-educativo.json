  "canonical_python": "def evaluate_rule(data):\n    tipo = data['tipo_declaracion']\n    tope = 180000 if tipo == 'conjunta' else 90000\n    if tipo == 'separada' or data['magi'] >= tope:\n        return 'Ninguno'\n    if (\n        not data['completo_4_anios']\n        and data['anios_aotc_pedidos'] < 4\n        and data['programa_con_titulo']\n        and data['al_menos_medio_tiempo']\n        and not data['condena_drogas']\n    ):\n        return 'AOTC'\n    return 'LLC'\n",
