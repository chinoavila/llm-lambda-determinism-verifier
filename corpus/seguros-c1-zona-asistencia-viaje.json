  "canonical_python": "LIMITROFES = ('Brasil', 'Chile', 'Uruguay', 'Paraguay', 'Bolivia')\nEUROPA = ('España', 'Italia', 'Francia', 'Alemania', 'Portugal', 'Reino Unido')\n\ndef evaluate_rule(data):\n    destino = data['destino']\n    if data['dias_viaje'] > 90:\n        return 'Larga estadía'\n    if destino in LIMITROFES:\n        return 'Limítrofe'\n    if destino in ('Estados Unidos', 'Canadá'):\n        return 'Norteamérica'\n    if destino in EUROPA:\n        return 'Europa'\n    return 'Resto del mundo'\n",
