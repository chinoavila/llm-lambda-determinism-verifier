  "canonical_python": "def evaluate_rule(data):\n    previos, poliza = data['siniestros_previos'], data['poliza']\n    if poliza == 'todo_riesgo':\n        deducible = 150000 if previos == 0 else 300000 if previos == 1 else 500000\n    elif poliza == 'terceros_completo':\n        deducible = 80000 if previos == 0 else 160000\n    else:\n        deducible = 0\n    if data['edad_conductor'] < 25:\n        deducible += 50000\n    return deducible\n",
